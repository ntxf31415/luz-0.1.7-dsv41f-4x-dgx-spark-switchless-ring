# 4× DGX Spark ring profile — LuZ 0.1.7 (dsv41-sglang-optimized:v7) 切换
# 2026-09-18 维护窗口。编排层用 LuZ 自带 start.sh；本站差异写在下面。
# 引擎形态 = Form A 原样：600K ctx × 16 路 = 9,600,000 = 池（PIN 守卫等号通过）。

# ─── cluster（rank 顺序 = 物理环：0=.55 1=.56 2=.58 3=.57）─────────────
HEAD_IP=HEAD_IP_PLACEHOLDER
WORKER_IPS="WORKER1_PLACEHOLDER WORKER2_PLACEHOLDER WORKER3_PLACEHOLDER"
WORKER_HOSTS="WORKER1_PLACEHOLDER WORKER2_PLACEHOLDER WORKER3_PLACEHOLDER"
WORKER_USER=spark
SSH_IDENTITY=$HOME/.ssh/id_ed25519

# ─── fabric（4 边环网，双 HCA，GID 铁律 -1）──────────────────────────
FABRIC_IFACE=enp1s0f1np1
GLOO_SOCKET_IFNAME=enP7s7
NCCL_SOCKET_IFNAME=enP7s7
IB_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,ENV
NCCL_HOST_DIR=/opt/nccl-ringonly
NCCL_BUFFSIZE=8388608
NCCL_MAX_NCHANNELS=4
NCCL_CROSS_NIC=1
NCCL_IB_MERGE_NICS=0
NCCL_IB_SUBNET_AWARE_ROUTING=1
# kernel-1031 GID 表重排：禁止自动探测，恒 -1
NCCL_IB_GID_INDEX_FORCE=-1

# per-rank PEER_HCA（物理环接线，值取自 v2.1-vl-r1 生产）
PEER_HCA_RANK0="1=rocep1s0f1,roceP2p1s0f1;3=rocep1s0f0,roceP2p1s0f0"
PEER_HCA_RANK1="0=rocep1s0f1,roceP2p1s0f1;2=rocep1s0f0,roceP2p1s0f0"
PEER_HCA_RANK2="1=rocep1s0f0,roceP2p1s0f0;3=rocep1s0f1,roceP2p1s0f1"
PEER_HCA_RANK3="0=rocep1s0f0,roceP2p1s0f0;2=rocep1s0f1,roceP2p1s0f1"

# 静态 ring NCCL + 通用 env，最后追加以覆盖重复项
# Form A 新增项：DSV41_MOE_B12X 族 / SKIP_NONFINAL_DECODER / QW3_DSPARK / KV_LAYOUT / DENSE_INDEXER 预算
# 保留：EP_SUPPRESS_NCCL_CHECK=1（首航照抄 Form A，P0.33 覆盖法留作后续臂）
# 本站旧栈专用的 knapcio 变量（DSV41_INDEXER_BUDGET_MIB / _CHUNKED / ADAPTIVE_*）一律不带
EXTRA_DOCKER_ENV="NCCL_ALGO=RING NCCL_IB_TIMEOUT=1000 NCCL_IB_RETRY_CNT=7 NCCL_IB_TOS=46 NCCL_IGNORE_CPU_AFFINITY=1 NCCL_MIN_NCHANNELS=4 NCCL_SET_THREAD_NAME=1 NCCL_NET_PLUGIN=none NCCL_TUNER_THRESHOLD=40960 NCCL_CUMEM_HOST_ENABLE=0 NCCL_DEBUG_FILE=/state/nccl-%h-%p.log TORCH_CUDA_ARCH_LIST=12.1a FLASHINFER_DISABLE_VERSION_CHECK=1 PYTHONFAULTHANDLER=1 HF_HUB_OFFLINE=1 DSV41_SHARED_PAD_K=1 EP_SUPPRESS_NCCL_CHECK=1 SGLANG_RAGGED_VERIFY_MODE=static MALLOC_ARENA_MAX=2 SGLANG_QW3_DSPARK_LAUNCH_PARAMS=1 SGLANG_DSV4_KV_LAYOUT=fork-v4-fp4 DSV41_DENSE_INDEXER_LOGITS_BUDGET_BYTES=536870912 DSV41_SKIP_NONFINAL_DECODER=1"

# ─── model / image ────────────────────────────────────────────────────
MODEL_DIR=/home/spark/models/DeepSeek-V4.1-Flash
COMMON_MODEL=/var/tmp/DeepSeek-V4.1-Flash
BASE_IMAGE=lmsysorg/sglang:dev-dsv41
IMAGE=dsv41-sglang-optimized:v7
EXPECTED_SHARDS=48

# ─── weights：四机全本地，无 NFS ──────────────────────────────────────
WEIGHTS_MODE=local
WORKER_MODEL_DIR=/home/spark/models/DeepSeek-V4.1-Flash
NFS_SHARE=0
WORKER_DIR=/home/spark/luz017
# 复用现役已打的 engram 分片（在新 WORKER_DIR 之外，故必须显式指定）
WORKER_ENGRAM_DIR=/home/spark/dsv41-4x-spark/engram

# ─── parallelism ──────────────────────────────────────────────────────
NNODES=4
TP_SIZE=4
EP_SIZE=2
DIST_PORT=20000

# ─── serving：接管 8899 loopback 引擎位 ───────────────────────────────
PORT=8899
HOST=127.0.0.1
API_KEY=${YOUR_API_KEY}
# 旧别名必须保留：下游 proxy / 门户在用 deepseek-v4-flash-vision-exp
SERVED_MODEL_NAME=deepseek-v4.1-flash,deepseek-v4-flash-vision-exp

OFFLOAD_MODE=nvme
DSV41_CACHE_GIB=1
DSV41_IO_THREADS=96
DSV41_RESIDENT_SCALES=0
DSV41_CACHE_WAYS=16
DSV41_STATS_SECONDS=60
# Form A 原样：600K × 16 = 9,600,000
CONTEXT_LENGTH=600000
MEM_FRACTION_STATIC=0.90
HEAD_MEM_FRACTION_STATIC=0.90
MAX_RUNNING_REQUESTS=16
CHUNKED_PREFILL_SIZE=4096
MAX_TOTAL_TOKENS=9600000
SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=5
DSPARK_SPS_TABLE=/state/dspark_sps.json
DSPARK_STS_TABLE=/state/dspark_sts.json

# ─── engram（head 侧；worker 侧见 WORKER_ENGRAM_DIR）─────────────────
ENGRAM_DIR=$HOME/dsv41-engram
DSV41_PACKED_DIR=/engram
SKIP_PREPARE=1
SKIP_VERIFY=1
SKIP_SMOKE=0
SMOKE_QUICK=1

# ─── kernels（GB10 / SM121）───────────────────────────────────────────
# --enable-metrics 是 RK3588 sparkdash 面板 token-rate 的依赖
# --prefill-decode-interval 8：冷长 prefill 期间每个 chunk 后插 8 轮解码，避免在途解码流被
#   冻住（实测冻结比 0.051 → 0.414；独跑冷加载零成本，代价只在有并发受害者时发生）
EXTRA_SGLANG_ARGS="--fp8-gemm-backend flashinfer_cutlass --watchdog-timeout 1800 --enable-metrics --min-free-slots-delay 1 --enable-deepseek-v4-fp4-indexer --prefill-decode-interval 8"
DSV41_MXFP8_BACKEND=b12x
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192

# ─── TP4 runtime ──────────────────────────────────────────────────────
DSV41_TP_PAD=0
